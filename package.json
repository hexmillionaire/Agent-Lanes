{
  "name": "@hexmillionaire/agent-lanes",
  "version": "0.3.0",
  "description": "Portable task scopes and handoffs for Claude Code, Codex, and human contributors.",
  "type": "module",
  "bin": {
    "agent-lanes": "bin/agent-lanes.mjs"
  },
  "exports": {
    ".": "./src/core.mjs",
    "./pr": "./src/pr.mjs"
  },
  "files": [
