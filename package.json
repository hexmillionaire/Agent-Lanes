{
  "name": "@hexmillionaire/agent-lanes",
  "version": "0.4.2",
  "description": "Offline CLI and GitHub Action that audit an AI coding agent's Git changes against a declared file scope, then print a handoff for the next agent.",
  "type": "module",
  "bin": {
    "agent-lanes": "bin/agent-lanes.mjs"
  },
  "exports": {
    ".": "./src/core.mjs",
    "./pr": "./src/pr.mjs"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md",
    "SECURITY.md",
    "action.yml"
  ],
  "scripts": {
    "test": "node --test",
    "demo": "node scripts/demo.mjs",
    "test:package": "node scripts/package-smoke.mjs",
    "benchmark": "node scripts/benchmark.mjs"
  },
  "engines": {
    "node": ">=24.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexmillionaire/Agent-Lanes.git"
  },
  "homepage": "https://github.com/hexmillionaire/Agent-Lanes#readme",
  "bugs": {
    "url": "https://github.com/hexmillionaire/Agent-Lanes/issues"
  },
  "license": "MIT",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "coding-agent",
    "agentic-coding",
    "git",
    "scope",
    "guardrails",
    "handoff",
    "task-scope",
    "pull-request",
    "github-action",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  }
}
